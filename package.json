{
  "name": "openhuman-knowledge-fabric",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenHuman Knowledge Fabric \u2014 institutional information platform (OH-DOC-000002-1-R01)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.18.1 <25",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "build": "pnpm -r build",
    "clean": "git clean -xdf node_modules dist .turbo && pnpm store prune",
    "db:migrate": "dbmate --migrations-dir ./database/migrations --no-dump-schema up && pnpm db:seed",
    "db:reset": "dbmate --migrations-dir ./database/migrations --no-dump-schema drop && pnpm db:migrate",
    "db:seed": "psql \"$DATABASE_URL\" -v ON_ERROR_STOP=1 -q -f generated/sql-registry/001-ontology-seed.sql",
    "db:status": "dbmate --migrations-dir ./database/migrations status",
    "db:up": "docker compose up -d postgres minio keycloak",
    "dogfood:load": "pnpm --filter @kf/api... build && NODE_ENV=development pnpm --filter @kf/api dogfood",
    "dev": "pnpm --parallel --filter \"./apps/**\" dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "ontology:approve": "node packages/ontology-compiler/dist/cli.js approve",
    "ontology:build": "tsc --build packages/ontology-compiler && node packages/ontology-compiler/dist/cli.js build",
    "ontology:check": "tsc --build packages/ontology-compiler && node packages/ontology-compiler/dist/cli.js check",
    "ontology:pack": "tsc --build packages/ontology-compiler && node packages/ontology-compiler/dist/cli.js pack",
    "ontology:verify": "node packages/ontology-compiler/dist/cli.js verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build && pnpm --filter @kf/web run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@kf/actions": "workspace:*",
    "@kf/agent-tools": "workspace:*",
    "@kf/artifacts": "workspace:*",
    "@kf/authorization": "workspace:*",
    "@kf/canonicalization": "workspace:*",
    "@kf/database": "workspace:*",
    "@kf/documents": "workspace:*",
    "@kf/export": "workspace:*",
    "@kf/integration": "workspace:*",
    "@kf/ontology-compiler": "workspace:*",
    "@kf/operations": "workspace:*",
    "@kf/orchestrator": "workspace:*",
    "@kf/product-quality": "workspace:*",
    "@kf/record-atoms": "workspace:*",
    "@kf/search": "workspace:*",
    "@kf/work-control": "workspace:*",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dbmate": "^2.35.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "fastify": "^5.11.3",
    "jose": "^6.2.8",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
