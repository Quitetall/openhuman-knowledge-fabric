{
  "name": "@kf/web",
  "version": "0.1.0",
  "private": true,
  "description": "Knowledge Fabric web application — cockpit, dossier, decision and quality views",
  "scripts": {
    "dev": "NODE_ENV=development next dev --port 3000",
    "build": "next build",
    "start": "next start --port 3000",
    "test:browser": "node --test --test-concurrency=1 e2e/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next"
  },
  "dependencies": {
    "@kf/agent": "workspace:*",
    "@kf/domain": "workspace:*",
    "@kf/ml-registry": "workspace:*",
    "@kf/ui": "workspace:*",
    "jose": "^6.2.8",
    "next": "^16.3.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "playwright-core": "^1.59.1"
  }
}
