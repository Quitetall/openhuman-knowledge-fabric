    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@kf/actions": "workspace:*",
    "@kf/database": "workspace:*",
    "@kf/domain": "workspace:*",
    "@kf/work-control": "workspace:*",
    "fastify": "^5.11.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
