{
  "name": "@kf/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Knowledge Fabric HTTP API — typed reads and typed actions",
  "main": "./dist/server.js",
  "scripts": {
    "dev": "node --watch --experimental-strip-types src/server.ts",
