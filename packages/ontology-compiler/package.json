{
  "name": "@kf/ontology-compiler",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Compiles ontology/*.yaml into all generated interchange artifacts",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "rm -rf dist *.tsbuildinfo",
    "check": "node ./scripts/not-implemented.mjs check",
    "build:artifacts": "node ./scripts/not-implemented.mjs build:artifacts"
  },
  "dependencies": {
    "@kf/domain": "workspace:*"
  }
}
