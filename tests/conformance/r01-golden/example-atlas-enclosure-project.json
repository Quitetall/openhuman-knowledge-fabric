      "extensions": {},
      "attributes": {
        "decision_scope": "019fe041-615d-7a4c-86f3-0ed91e0cf127",
        "decision_type": "architecture",
        "context": "Connector insertion and drop loads should not be carried solely by the external shell.",
        "question": "Should PCB retention loads be carried by the shell or by an independent internal frame?",
        "options": [
          {
            "option_id": "SHELL",
            "title": "Load-bearing shell",
            "description": "Mount PCBs directly to the exterior shell.",
            "advantages": [
              "Fewer parts"
            ],
            "disadvantages": [
              "Couples cosmetic shell to structural loads"
            ]
          },
          {
            "option_id": "FRAME",
            "title": "Independent internal frame",
            "description": "Use a dedicated internal structure for PCB and connector loads.",
            "advantages": [
              "Serviceable",
              "Controls load path"
            ],
            "disadvantages": [
              "Additional part"
            ]
          }
        ],
        "decision": "Select the independent internal frame architecture.",
        "rationale": "It separates structural retention from cosmetic enclosure changes and reduces load transfer into PCB connectors.",
        "consequences": [
          "Additional internal part",
          "Separate frame drawing and verification"
        ],
        "proposer": "019fe041-615d-7aa7-b33f-8ffbd2fce6b2",
        "decision_authority": "019fe041-615d-75a1-8100-a80ec5f0a3be",
        "originating_work_execution": "019fe041-615d-7880-a88b-35e41679e08e",
        "accepted_at": "2026-08-08T07:23:28.989895Z"
      },
