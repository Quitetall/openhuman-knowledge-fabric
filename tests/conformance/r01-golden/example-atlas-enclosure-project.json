      "title": "Use Independent Internal Structural Frame",
      "state": "accepted",
      "classification": "confidential",
      "owner": "019fe041-615d-75a1-8100-a80ec5f0a3be",
      "created_at": "2026-08-08T07:23:28.989895Z",
