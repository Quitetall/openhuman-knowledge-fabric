# Copy to .env for local development. Never commit a populated .env.
#
# Every value here is a development default matching docker-compose.yml. They are public on
# purpose. Staging and production values come from a secret manager (Gate 8), never a file.

NODE_ENV=development
LOG_LEVEL=debug

# API
HOST=0.0.0.0
PORT=4000

# Database. The application connects as kf_app, never as the owner — an application role
# that owns its own schema can silently alter the structure it is meant to be constrained by.
DATABASE_URL=postgres://kf_app:dev-only-not-a-secret@localhost:5432/kf
# Migrations run as kf_migrator, which is the only role permitted to change structure.
DATABASE_MIGRATION_URL=postgres://kf_migrator:dev-only-not-a-secret@localhost:5432/kf
# dbmate reads this name specifically.
DATABASE_URL_DBMATE=postgres://kf_migrator:dev-only-not-a-secret@localhost:5432/kf?sslmode=disable

# Object storage (evidence vault)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kf-dev-access-key
S3_SECRET_ACCESS_KEY=dev-only-not-a-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ARTIFACTS=kf-artifacts
S3_BUCKET_SNAPSHOTS=kf-snapshots
S3_BUCKET_CHECKPOINTS=kf-checkpoints
S3_BUCKET_EXPORTS=kf-exports

# Identity
OIDC_ISSUER_URL=http://localhost:8080/realms/knowledge-fabric
OIDC_CLIENT_ID=knowledge-fabric-api

# Worker
WORKER_CONCURRENCY=4

# Audit checkpoint signing.
# This key must NOT be readable by the API process. A compromised API can then forge
# records, but cannot forge a checkpoint attesting that those records were always present.
CHECKPOINT_SIGNING_KEY_PATH=./infrastructure/local/checkpoint-dev-ed25519.key
