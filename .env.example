# Copy to .env for local development. Never commit a populated .env.
#
# Every populated value here is a development default matching docker-compose.yml. They are
# public on purpose. This file must never be used for a shared dogfood or private-host process.
# Those deployments use real secrets supplied as files and a real bearer identity provider.

NODE_ENV=development
KF_DEPLOYMENT_PROFILE=development
LOG_LEVEL=debug

# API
HOST=0.0.0.0
PORT=4000
# Server-side URL used by the Next.js application. It is intentionally not NEXT_PUBLIC_*:
# browsers never call the API directly and the same build can receive a different runtime URL.
KF_API_URL=http://localhost:4000

# Database. Local dogfood bootstrap uses owner access once to create kf_api_dev and seed the
# first organization/operator. Application runtime then inherits constrained kf_app grants.
DATABASE_OWNER_URL=postgres://kf_owner:dev-only-not-a-secret@localhost:5432/kf
DATABASE_URL=postgres://kf_api_dev:dev-only-not-a-secret@localhost:5432/kf
# `kf_migrator` is a NOLOGIN privilege role, not a database account. Initial local bootstrap
# runs from DATABASE_OWNER_URL as documented below. Private hosts provision a separate login
# that inherits `kf_migrator` and supply its URL through the owner-only migrator secret file.

# Object storage (evidence vault)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kf-dev-access-key
S3_SECRET_ACCESS_KEY=dev-only-not-a-secret
S3_FORCE_PATH_STYLE=true
S3_BUCKET_ARTIFACTS=kf-artifacts
S3_BUCKET_SNAPSHOTS=kf-snapshots
S3_BUCKET_CHECKPOINTS=kf-checkpoints
S3_BUCKET_EXPORTS=kf-exports

# Fixed identity: development/test only, visibly synthetic and never authoritative. The
# dogfood loader prints these three as a paste-ready block when it finishes; copy them in
# before starting the web app, which throws if any is blank. KF_ALLOW_FIXED_IDENTITY is
# ignored as permission to bypass bearer identity when KF_DEPLOYMENT_PROFILE=dogfood.
#
# ALL THREE ARE UUIDs. This file said so, then on 2026-08-21 I "corrected" it to claim
# KF_DEV_ACTING_ROLE was a role name like `system_administrator`. That was wrong: it is the id
# of a row in `org.role_assignment` — the assignment that grants the role, not the role itself.
# `core.set_transaction_context(p_acting_role uuid)` takes nothing else. The original wording
# was right and I broke it; the loader's own output settles it, which is the argument for
# having the loader print them rather than describing them in prose.
KF_ALLOW_FIXED_IDENTITY=1
KF_DEV_ACTOR=
KF_DEV_ACTING_ROLE=
KF_DEV_ORGANIZATION=
KF_DEV_CLASSIFICATION=internal

# Local Keycloak administration. These fixed public values are safe only while Compose ports
# remain bound to this workstation. Replace them before exposing Keycloak to any network.
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=dev-only-not-a-secret

# API OIDC contract for KF_DEPLOYMENT_PROFILE=dogfood. All three names match config.ts and
# must be set together. The example URLs become valid only after the realm and API audience
# are configured in Keycloak; merely starting the container does not provision either one.
# Keep them unset in the development profile so the API uses the explicit fixed-identity path.
# OIDC_ISSUER=http://localhost:8080/realms/knowledge-fabric
# OIDC_AUDIENCE=knowledge-fabric-api
# OIDC_JWKS_URI=http://localhost:8080/realms/knowledge-fabric/protocol/openid-connect/certs

# Web OIDC authorization-code + PKCE client for dogfood. Redirect URI must exactly match the
# reviewed client registration. Inline session secret is development-only; generate 32 random
# bytes as canonical base64. Production must use the owner-only file variant instead.
# KF_WEB_OIDC_ISSUER=http://localhost:8080/realms/knowledge-fabric
# KF_WEB_OIDC_CLIENT_ID=knowledge-fabric-web
# KF_WEB_OIDC_REDIRECT_URI=http://localhost:3000/auth/callback
# KF_WEB_SESSION_SECRET=REPLACE_WITH_32_RANDOM_BYTES_AS_BASE64
# KF_WEB_SESSION_SECRET_FILE=/run/secrets/kf_web_session_secret

# Worker
WORKER_CONCURRENCY=4

# Audit checkpoint signing.
# This key must NOT be readable by the API process. A compromised API can then forge
# records, but cannot forge a checkpoint attesting that those records were always present.
CHECKPOINT_SIGNING_KEY_PATH=./infrastructure/local/checkpoint-dev-ed25519.key
# Verification trust is external and append-only. Keep every historical
# <CHECKPOINT_SIGNING_KEY_ID>.pub after rotation. Never place private keys here.
CHECKPOINT_PUBLIC_KEY_DIR=./infrastructure/local/checkpoint-public-keys
