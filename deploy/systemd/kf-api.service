[Unit]
Description=Knowledge Fabric API
Documentation=file:///opt/kf/docs/deployment/private-host.md
Wants=network-online.target kf-attestor.service
After=network-online.target kf-attestor.service postgresql.service kf-objects.service
# postgresql.service and kf-objects.service: ordering only, never a dependency, because either
# may live on another host. On a host that runs them (ADR 0039) a boot without it started this
# unit first, it failed on "the database system is starting up", and OnFailure= sent an alert on
# every boot (KF-WAR-0001 rehearsal, 2026-10-07). After= on a unit that does not exist is a no-op.
OnFailure=kf-alert@%n.service
# A crash loop must END in `failed`, because `failed` is the only state OnFailure= reacts to.
# Restart=on-failure alone restarts forever: the unit sits in `activating (auto-restart)`, the
# alert never fires, and a service that has not served a request in hours looks merely busy.
# More than 5 starts inside 30 minutes stops the loop and alerts; `systemctl reset-failed`
# after the fix re-arms it. A crash cycle slower than ~6 minutes never trips this — readiness
# and the far-end heartbeat are what notice that one.
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=simple
User=kf-api
Group=kf-api
WorkingDirectory=/opt/kf/apps/api
EnvironmentFile=/etc/kf/api.env
ExecStartPre=/usr/bin/test -s /etc/kf/api/database-url
ExecStartPre=/usr/bin/test -s /etc/kf/api/s3-secret-access-key
# Command-local values cannot be weakened by a value accidentally left in api.env.
ExecStartPre=/usr/bin/test -s /opt/kf/generated/projections/knowledge-fabric.projections.json
# The database binds a person for this login only on an attestation from kf-attestor
# (20260924001000). Wait up to ten seconds for its socket rather than serving a wall of 401s;
# kf-api reaches it as a member of kf-attest (docs/deployment/private-host.md). `$$` is systemd's
# escape for a literal `$`.
ExecStartPre=/bin/sh -c 'for i in $$(seq 1 50); do test -S /run/kf-attestor/attestor.sock && exit 0; sleep 0.2; done; echo "kf-attestor socket /run/kf-attestor/attestor.sock is absent" >&2; exit 1'
ExecStart=/usr/bin/env NODE_ENV=production KF_DEPLOYMENT_PROFILE=dogfood KF_TLS_TERMINATED_UPSTREAM=1 DATABASE_URL_FILE=/etc/kf/api/database-url S3_SECRET_ACCESS_KEY_FILE=/etc/kf/api/s3-secret-access-key KF_ATTESTOR_SOCKET=/run/kf-attestor/attestor.sock KF_PROJECTIONS_ARTIFACT=/opt/kf/generated/projections/knowledge-fabric.projections.json HOST=127.0.0.1 PORT=4000 /usr/bin/node /opt/kf/apps/api/dist/server.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
# Ceilings for the whole cgroup, pandoc children included. Document parsing runs here, one
# pandoc per import capped at a 512 MiB GHC heap (KF_PANDOC_MAX_HEAP_MIB); these bound what
# several at once, or anything else going wrong, can take from the host. MemoryHigh throttles
# and reclaims first so MemoryMax (the OOM kill) is the last resort, not the first signal.
MemoryHigh=2G
MemoryMax=3G
TasksMax=512

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
