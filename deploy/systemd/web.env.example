# Non-secret web routing. Install as /etc/kf/web.env, owned root:kf-web, mode 0640.
KF_WEB_OIDC_ISSUER=https://identity.example.internal/realms/knowledge-fabric
KF_WEB_OIDC_CLIENT_ID=knowledge-fabric-web
KF_WEB_OIDC_REDIRECT_URI=https://fabric.example.internal/auth/callback
# The in-app agent (ADR 0040; docs/agents/in-app-agent.md). Every line is optional; with none, the
# agent answers nothing that needs a model and says so.
# LAMU on this host, loopback only. Without it, confidential and restricted questions are refused.
# KF_AGENT_LAMU_URL=http://127.0.0.1:8020
# KF_AGENT_LAMU_MODEL=
# KF_AGENT_LAMU_TOKEN_FILE=/etc/kf/web/lamu-token
# A provider's model for public and internal content, where the organization allows it. The key is
# an owner-only file, never an environment variable.
# KF_AGENT_PROVIDER=anthropic
# KF_AGENT_PROVIDER_KEY_FILE=/etc/kf/web/provider-api-key
# KF_AGENT_PROVIDER_MODEL=claude-opus-5-5
# KF_AGENT_PREFER=provider
# The in-app agent's own OAuth client, declared with `kf declare-agent`, for token exchange.
# KF_WEB_AGENT_CLIENT_ID=knowledge-fabric-web-agent
# KF_WEB_AGENT_CLIENT_SECRET_FILE=/etc/kf/web/agent-client-secret
