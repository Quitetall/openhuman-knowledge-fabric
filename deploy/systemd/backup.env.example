# Public identifiers and external custody paths only. Never paste private key bytes here.
PRESERVATION_SIGNING_KEY_ID=replace-with-immutable-key-id
PRESERVATION_SIGNING_KEY_PATH=/etc/kf/backup/preservation-manifest-key
PRESERVATION_TRUST_STORE_DIR=/etc/kf/preservation-trust.d
# One coherent PostgreSQL 18 client toolchain; scripts reject any other major or mixed PATH.
KF_POSTGRES_CLIENT_DIR=/usr/bin
# Root-owned adapter. Receives a request file (one {"storage_uri","storage_version"} per line) and a
# proof path; writes one line per object with the sha256 and size_bytes it measured by re-reading it.
KF_OBJECT_STORE_VERIFY_PROGRAM=/usr/local/libexec/kf-verify-object-store
# Its reviewed SHA-256. restore-verify.sh refuses to run a program whose digest differs.
KF_OBJECT_STORE_VERIFY_PROGRAM_SHA256=replace-with-reviewed-sha256
KF_OBJECT_STORE_PROOF_REF=object-store://production/latest-restored-inventory
# OpenPGP PUBLIC key every backup is encrypted to before anything leaves this host. The matching
# private key is held by whoever performs recovery, never on this host; backup.sh refuses a file
# that contains one. Public, so 0644 root:root is fine.
KF_BACKUP_RECIPIENT_FILE=/etc/kf/backup-recipient.asc
# Newest local backups kept. Older ones are removed only once an off-site copy is recorded.
KF_BACKUP_RETAIN_LOCAL=7
# Free space kept in reserve beyond twice the previous backup's size.
KF_BACKUP_FREE_SPACE_RESERVE_BYTES=1073741824
# Restore drill: where the off-site copies went (rsync syntax, as in offsite.env) and the label
# they were recorded under. The drill pulls the newest one back and restores THAT.
KF_DRILL_OFFSITE_SOURCE=
KF_DRILL_OFFSITE_LABEL=
# PostgreSQL 18 initdb and pg_ctl, for the drill's throwaway cluster.
KF_POSTGRES_SERVER_DIR=/usr/lib/postgresql/18/bin
