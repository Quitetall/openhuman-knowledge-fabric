# Non-secret worker routing. Valid range 1..128. Install as /etc/kf/worker.env,
# owned root:kf-worker, mode 0640.
WORKER_CONCURRENCY=4

# Exact production compiler host contract. The owner registry separately pins and enables
# matching executable/Cargo.lock/runtime-closure digests; startup fails if sandbox cannot run.
LIMINAL_COMPILER_PATH=/opt/kf/vendor/liminal/liminal-document-compiler
LIMINAL_CARGO_LOCK_PATH=/opt/kf/vendor/liminal/Cargo.lock
LIMINAL_EXECUTABLE_SHA256=replace-with-lowercase-sha256
LIMINAL_CARGO_LOCK_SHA256=replace-with-lowercase-sha256
LIMINAL_RUNTIME_CLOSURE_SHA256=replace-with-lowercase-rfc8785-sha256
LIMINAL_BWRAP_PATH=/usr/bin/bwrap
# Colon-separated exact ELF interpreter/shared-library closure for reviewed compiler bytes.
# Files must be root-owned, non-writable by group/other, <=128 MiB each and <=512 MiB total.
# Directories and ambient /usr trees are rejected; sealing this list does not qualify compiler.
LIMINAL_RUNTIME_FILE_PATHS=/lib64/ld-linux-x86-64.so.2:/lib/x86_64-linux-gnu/libc.so.6

# The working store: by default this host's own kf-objects (SeaweedFS on loopback, ADR 0039),
# whose identities provision-host.sh renders; name another S3 store here to use that instead.
S3_ENDPOINT=http://127.0.0.1:8333
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=kf-worker
S3_SECRET_ACCESS_KEY_FILE=/etc/kf/worker/s3-secret-access-key
S3_BUCKET_ARTIFACTS=kf-artifacts
S3_FORCE_PATH_STYLE=true
