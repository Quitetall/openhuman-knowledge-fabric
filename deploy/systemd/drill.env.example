# Object-store routing for the restore drill's verifier. Non-secret. Install as /etc/kf/drill.env,
# owned root:kf-drill, mode 0640; scripts/deploy/provision-host.sh does.
#
# The drill re-reads every stored object a restored backup references, to prove the records it
# brought back still have their bytes. A READ-ONLY key on the artifacts bucket is enough, and is
# what the drill should hold: s3:GetObject and s3:GetObjectVersion. Its secret is the owner-only
# file /etc/kf/drill/s3-secret-access-key, never a value here.
S3_ENDPOINT=https://objects.example.internal
S3_REGION=private-1
S3_ACCESS_KEY_ID=replace-with-drill-read-only-access-key-id
S3_BUCKET_ARTIFACTS=kf-artifacts
S3_FORCE_PATH_STYLE=false
# For encrypted B2 archive retrieval, KF_DRILL_OFFSITE_SOURCE=b2 selects the dedicated
# exact-version adapter. This is separate from S3_* artifact verification above.
# Deliver KF_B2_S3_ENDPOINT_FILE, KF_B2_BUCKET_NAME_FILE, KF_B2_APPLICATION_KEY_ID_FILE and
# KF_B2_APPLICATION_KEY_FILE through the selected volatile credential channel, not values here.
