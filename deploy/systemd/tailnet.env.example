# How people reach this host (ADR 0039). Non-secret. Install as /etc/kf/tailnet.env, owned
# root:kf-tls, mode 0640; scripts/deploy/provision-host.sh does, and fills both values from
# `tailscale status` once the host is up on the tailnet.
#
# tailnet     nginx on the tailnet address only, a `tailscale cert` certificate renewed by
#             kf-tls-renew.timer (deploy/nginx/knowledge-fabric-tailnet.conf).
# private-ca  the alternative: a private network and a certificate from a CA you run
#             (deploy/nginx/knowledge-fabric.conf); provisioning then checks none of the below.
KF_HOST_ACCESS=tailnet
# This host's tailnet name, <host>.<tailnet>.ts.net — the name its certificate is issued for.
KF_TAILNET_HOSTNAME=
# Its tailnet IPv4 address (`tailscale ip -4`), the one address nginx listens on.
KF_TAILNET_ADDRESS=
