[Unit]
Description=Knowledge Fabric local semantic embedding provider
Documentation=file:///opt/kf/docs/deployment/embedding-runtime.md
OnFailure=kf-alert@%n.service
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=exec
User=kf-embedding
Group=kf-embedding
UnsetEnvironment=NODE_OPTIONS NODE_PATH PYTHONPATH PYTHONHOME LAMU_API_TOKEN
ExecStart=/usr/bin/node /opt/kf/scripts/retrieval/startup.mjs provider /etc/kf/retrieval-runtime.json
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillMode=control-group
LimitCORE=0
MemoryHigh=4G
MemoryMax=5G
MemorySwapMax=0
CPUQuota=300%
TasksMax=64
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
