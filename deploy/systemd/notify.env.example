# Install as /etc/kf/notify.env, owned root:kf-notify, mode 0640.
# Where a digest's links point: the web application's public origin.
KF_NOTIFY_WEB_ORIGIN=https://kf.example.invalid
# The person whose phone this host's alert path reaches (a person id). Urgent items for anyone
# else are told by the digest only, until per-person push topics exist.
KF_NOTIFY_PUSH_PERSON=
# ntfy-healthchecks for a free ntfy topic (docs/deployment/phone-alerts.md); webhook otherwise.
KF_ALERT_PROVIDER=webhook
# When the SMTP relay authenticates:
# KF_NOTIFY_SMTP_PASSWORD_FILE=/etc/kf/notify/smtp-password
