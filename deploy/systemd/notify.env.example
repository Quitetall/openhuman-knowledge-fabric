# Install as /etc/kf/notify.env, owned root:kf-notify, mode 0640.
# Where a digest's links point: the web application's public origin.
KF_NOTIFY_WEB_ORIGIN=https://kf.example.invalid
# The person whose phone this host's alert path reaches (a person id), when they have set no push
# destination of their own. Anyone else with no destination is told by the digest.
KF_NOTIFY_PUSH_PERSON=
# The push servers a person's own destination may name (origins, comma-separated). The API's
# /etc/kf/api.env must name the same list. Their destinations are opened with
# /etc/kf/notify/destination-key, which provision-host.sh generates.
KF_NOTIFY_PUSH_SERVERS=https://ntfy.sh
# ntfy-healthchecks for a free ntfy topic (docs/deployment/phone-alerts.md); webhook otherwise.
KF_ALERT_PROVIDER=webhook
# When the SMTP relay authenticates:
# KF_NOTIFY_SMTP_PASSWORD_FILE=/etc/kf/notify/smtp-password
