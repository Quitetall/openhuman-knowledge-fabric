# Checkpoint signer routing. Install as /etc/kf/checkpoint.env, owned root:kf-checkpoint, mode 0640.
# No secrets here: the signing key and the anchor secret are files under /etc/kf/checkpoint/.
#
# The id every checkpoint is signed under. Immutable per key: a NEW key gets a NEW id, and its
# public half is installed as /etc/kf/checkpoint-public-keys/<id>.pub BEFORE the signer uses it.
# `--run` refuses when that file is missing or holds a different key.
CHECKPOINT_SIGNING_KEY_ID=replace-with-immutable-key-id
# External anchor: each signed checkpoint is also written here, where the database administrator
# is not the same principal. Required in production; without it the checkpoint is still signed
# into the database and the run then fails, so OnFailure= reaches a person.
CHECKPOINT_S3_ENDPOINT=
CHECKPOINT_S3_REGION=
CHECKPOINT_S3_ACCESS_KEY_ID=
CHECKPOINT_S3_BUCKET=kf-audit
