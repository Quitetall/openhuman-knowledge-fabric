# Storage sweep routing (kf-storage.service). Non-secret, but it names the service actor, so it
# is closed to the one identity that reads it: install as /etc/kf/storage/storage.env, owned
# kf-storage, mode 0600. scripts/deploy/provision-host.sh does.
#
# Working store: the artifacts bucket the API writes evidence to. Secret: /etc/kf/storage/s3-secret.
# Orphan collection (--collect-orphans) needs this key to hold the policy in
# deploy/object-store/kf-storage-orphan-collection.policy.json; provision-host.sh applies it
# when `mc` has an admin alias, and `provision-host.sh --check` confirms it.
S3_ENDPOINT=https://objects.example.internal
S3_REGION=private-1
S3_ACCESS_KEY_ID=replace-with-storage-access-key-id
S3_BUCKET_ARTIFACTS=kf-artifacts
S3_FORCE_PATH_STYLE=false
# Durable store every version is replicated into: the `durable` store (ADR 0017), on the first
# host a Backblaze B2 bucket (ADR 0039). The first run binds `durable` to this endpoint and bucket
# in content.artifact_store (content.bind_artifact_store), and every later run is held to them:
# change either and kf-storage refuses with artifact_store_address_mismatch.
#   S3_DURABLE_ENDPOINT        the bucket's S3 endpoint, https://s3.<region>.backblazeb2.com
#   S3_DURABLE_REGION          its region, e.g. us-west-004 (the part of the endpoint after s3.)
#   S3_DURABLE_ACCESS_KEY_ID   the B2 application key's keyID (not secret)
#   S3_DURABLE_BUCKET          a bucket with versioning (every B2 bucket keeps versions)
#   S3_DURABLE_FORCE_PATH_STYLE  true: <endpoint>/<bucket>/<key>; false: <bucket>.<endpoint>/<key>.
#                              B2 accepts both.
#   S3_DURABLE_CONDITIONAL_CREATE  true sends If-None-Match: * on every copy, so an existing object
#                              is never overwritten by the store itself. B2 documents no
#                              conditional writes: if a replication fails with a 4xx/501 naming
#                              that header, set false, and kf-storage checks for the key first.
# Secret: the B2 applicationKey in /etc/kf/storage/s3-durable-secret (0600 kf-storage), never here.
# The key needs, on this bucket only: listBuckets, readFiles, writeFiles (and listFiles, for
# --verify's reads). Not deleteFiles: kf-storage never removes a durable copy.
S3_DURABLE_ENDPOINT=https://durable-objects.example.internal
S3_DURABLE_REGION=private-2
S3_DURABLE_ACCESS_KEY_ID=replace-with-durable-access-key-id
S3_DURABLE_BUCKET=kf-artifacts-durable
S3_DURABLE_FORCE_PATH_STYLE=false
S3_DURABLE_CONDITIONAL_CREATE=true
# The declared service actor, as printed by `pnpm kf:declare-service-actor`. Declare it at
# `restricted`: orphan collection refuses to run below the top classification, where records it
# cannot see would make their bytes look unreferenced.
KF_STORAGE_ORGANIZATION=replace-with-organization-uuid
KF_STORAGE_ACTOR=replace-with-service-actor-person-uuid
# The role assignment ends within a year (ADR 0036): `kf:declare-service-actor --valid-to`, one
# year by default. Renew it before then with `pnpm kf:grant-authority --person <KF_STORAGE_ACTOR>
# --renew …`; the renewal is a NEW assignment, so replace KF_STORAGE_ROLE with the id it prints.
# A lapsed assignment makes every sweep fail with a refusal, which the timer's failure hook reports.
KF_STORAGE_ROLE=replace-with-service-actor-role-assignment-uuid
KF_STORAGE_CLASSIFICATION=restricted
