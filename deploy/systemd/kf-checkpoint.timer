[Unit]
Description=Sign a checkpoint hourly

[Timer]
# How long this may go without firing before scripts/timer-liveness.sh reports it (systemd
# ignores X- keys). Hourly plus up to 5 minutes of spread: two hours silent means at least one
# signing was missed.
X-KF-MaxSilenceSec=7200
OnCalendar=hourly
# Spread across the hour so a fleet does not sign simultaneously, and so the interval between
# checkpoints stays roughly constant rather than drifting toward the top of the hour.
RandomizedDelaySec=300
# A missed run — a reboot, a maintenance window — signs on the next start rather than waiting
# for the next hour. The unsigned window is the thing being minimised.
Persistent=true

[Install]
WantedBy=timers.target
