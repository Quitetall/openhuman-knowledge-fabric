[Unit]
Description=Daily digest of what needs each person (ADR 0040 decision 9)

[Timer]
Unit=kf-notify@digest.service
# How long this may go without firing before scripts/timer-liveness.sh reports it (systemd
# ignores X- keys). Daily plus 15 minutes of spread: 26 hours silent means a day was missed.
X-KF-MaxSilenceSec=93600
# The send time is the owner's choice (ADR 0040's open item); 07:00 host time until then.
OnCalendar=*-*-* 07:00:00
RandomizedDelaySec=900
# A host that was off at 07:00 sends when it comes back rather than skipping a day.
Persistent=true

[Install]
WantedBy=timers.target
