[Unit]
Description=Restore the newest off-site backup into a scratch database and prove it restored
Documentation=file:///opt/kf/docs/operating-model/runbook.md
OnFailure=kf-alert@%n.service

[Service]
Type=oneshot
User=kf-backup
Group=kf-backup
WorkingDirectory=/opt/kf
Environment=DATABASE_URL_FILE=/etc/kf/backup/database-url
EnvironmentFile=/etc/kf/backup.env
Environment=CHECKPOINT_PUBLIC_KEY_DIR=/etc/kf/checkpoint-public-keys
ExecStartPre=/usr/bin/test -s /etc/kf/backup/preservation-manifest-key
ExecStartPre=/usr/bin/test -d /etc/kf/preservation-trust.d
ExecStartPre=/usr/bin/test -x /usr/local/libexec/kf-verify-object-store
# Creates the scratch database, restores, compares, records the drill against the PRODUCTION
# ledger, and drops the scratch database on the way out. The logic is in a script rather than
# inline here so that it can be read, and so `bash -n` covers it.
ExecStart=/opt/kf/scripts/restore-drill.sh /srv/kf-backups
# Three hours. A restore that has not finished by then is itself the finding.
TimeoutStartSec=3h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/kf-backups
ReadWritePaths=/run/kf
ProtectHome=true
UMask=0077
