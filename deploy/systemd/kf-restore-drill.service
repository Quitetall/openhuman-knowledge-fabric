[Unit]
Description=Pull the newest off-site backup back, restore it into a throwaway cluster, prove it restored
Documentation=file:///opt/kf/docs/operating-model/runbook.md
OnFailure=kf-alert@%n.service

[Service]
Type=oneshot
# Its own identity, not kf-backup. The drill holds the key that DECRYPTS backups; the backup
# job holds the key that SIGNS them. Until 2026-09-23 both ran as kf-backup, so the decryption
# credential was one `systemctl` away from the uid that writes the archive, and the only
# separation was which unit named it. A uid is the boundary a filesystem can enforce; a unit
# name is not. The drill no longer needs the preservation signing key at all (restore-verify.sh
# signs its throwaway re-export with a key made for that run), so kf-drill holds exactly: the
# sealed decryption credential, a ledger login, and a read credential for the object store.
User=kf-drill
Group=kf-drill
WorkingDirectory=/opt/kf
Environment=DATABASE_URL_FILE=/etc/kf/drill/database-url
# KF_DRILL_* and the trust-store path. backup.env is non-secret routing; its
# PRESERVATION_SIGNING_KEY_PATH is not readable by this uid and is not used by the drill.
EnvironmentFile=/etc/kf/backup.env
# The object store the drill re-reads to prove recovered records still have their bytes:
# S3_ENDPOINT, S3_REGION, S3_ACCESS_KEY_ID, S3_BUCKET_ARTIFACTS. Read by the in-release
# verifier (apps/kf-storage/dist/verify-object-store.js) unless backup.env names an override.
EnvironmentFile=/etc/kf/drill.env
Environment=S3_SECRET_ACCESS_KEY_FILE=/etc/kf/drill/s3-secret-access-key
Environment=CHECKPOINT_PUBLIC_KEY_DIR=/etc/kf/checkpoint-public-keys
ExecStartPre=/usr/bin/test -s /etc/kf/drill/database-url
ExecStartPre=/usr/bin/test -s /etc/kf/drill/s3-secret-access-key
ExecStartPre=/usr/bin/test -d /etc/kf/preservation-trust.d
# The key that decrypts off-site copies. Sealed with `systemd-creds encrypt` to this host, and
# decrypted by systemd into this unit's private credential directory for the length of one run
# only: it is never a plaintext file on disk, and no other unit — and no other uid — names it.
# Hosts that can should run this unit on a separate recovery machine instead; the script is the
# same there.
LoadCredentialEncrypted=backup-decryption-key:/etc/kf/credstore.encrypted/backup-decryption-key
Environment=KF_DRILL_DECRYPTION_KEY_FILE=%d/backup-decryption-key
# ...and so its custody is systemd's, checked by the release's native helper, not the owner-only
# file rule (scripts/restore-drill.sh says why).
Environment=KF_DRILL_DECRYPTION_KEY_CUSTODY=systemd
# The throwaway PostgreSQL cluster lives here, one private subdirectory per run, deleted on exit.
StateDirectory=kf-restore-drill
StateDirectoryMode=0700
Environment=KF_DRILL_WORK_ROOT=/var/lib/kf-restore-drill
# Pulls the off-site copy named by KF_DRILL_OFFSITE_SOURCE/LABEL (backup.env) back, checks it is
# the ciphertext the ledger recorded as sent, decrypts, restores into a throwaway cluster on its
# own socket and port, compares, records against the PRODUCTION ledger, and deletes the cluster.
# It never creates a database in the production cluster. The logic is in a script rather than
# inline here so that it can be read, and so `bash -n` covers it.
ExecStart=/opt/kf/scripts/restore-drill.sh /srv/kf-backups
# Three hours. A restore that has not finished by then is itself the finding.
TimeoutStartSec=3h

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
