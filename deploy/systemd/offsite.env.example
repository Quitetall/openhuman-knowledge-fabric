# Where kf-backup-offsite.service ships each backup's ENCRYPTED archive. Non-secret routing only.
# KF_OFFSITE_DESTINATION and KF_OFFSITE_LABEL are required; the unit refuses to start while empty.
# Install as /etc/kf/offsite.env, owned root:kf-offsite, mode 0640.
#
# rsync syntax: a local directory (/mnt/vault/kf) or user@host:/srv/backups/kf. A local directory
# also needs `ReadWritePaths=` in a drop-in (systemctl edit kf-backup-offsite.service), and is
# recorded as NOT off-site unless KF_OFFSITE_FAILURE_DOMAIN names an approved failure domain.
KF_OFFSITE_DESTINATION=
# Use the literal b2 for the dedicated version-pinned cloud adapter; never s3:// in rsync.
# KF_B2_S3_ENDPOINT_FILE, KF_B2_BUCKET_NAME_FILE, KF_B2_APPLICATION_KEY_ID_FILE and
# KF_B2_APPLICATION_KEY_FILE must come from the selected volatile credential channel.
# Values, especially application credentials, never belong in this environment file.
# The name recorded in ops.backup_copy. Never the destination itself, which can carry a username.
KF_OFFSITE_LABEL=
# Optional. The ops.physical_failure_domain_evidence domain_ref this destination sits in, as
# approved by a person. Set it and the copy is recorded off-site with encryption evidence; leave it
# empty and a local destination counts as this host.
KF_OFFSITE_FAILURE_DOMAIN=
PRESERVATION_TRUST_STORE_DIR=/etc/kf/preservation-trust.d
KF_POSTGRES_CLIENT_DIR=/usr/bin
