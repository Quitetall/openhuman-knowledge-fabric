[Unit]
Description=Knowledge Fabric background worker
Documentation=file:///opt/kf/docs/deployment/private-host.md
Wants=network-online.target
After=network-online.target postgresql.service kf-objects.service
# postgresql.service and kf-objects.service: ordering only, never a dependency, because either
# may live on another host. On a host that runs them (ADR 0039) a boot without it started this
# unit first, it failed on "the database system is starting up", and OnFailure= sent an alert on
# every boot (KF-WAR-0001 rehearsal, 2026-10-07). After= on a unit that does not exist is a no-op.
OnFailure=kf-alert@%n.service
# A crash loop must END in `failed`, because `failed` is the only state OnFailure= reacts to.
# Restart=on-failure alone restarts forever: the unit sits in `activating (auto-restart)`, the
# alert never fires, and a service that has not served a request in hours looks merely busy.
# More than 5 starts inside 30 minutes stops the loop and alerts; `systemctl reset-failed`
# after the fix re-arms it. A crash cycle slower than ~6 minutes never trips this — readiness
# and the far-end heartbeat are what notice that one.
StartLimitIntervalSec=30min
StartLimitBurst=5

[Service]
Type=simple
User=kf-worker
Group=kf-worker
WorkingDirectory=/opt/kf/apps/worker
EnvironmentFile=/etc/kf/worker.env
UnsetEnvironment=NODE_OPTIONS NODE_PATH
ExecStartPre=/usr/bin/test -s /etc/kf/worker/database-url
ExecStartPre=/usr/bin/test -s /etc/kf/worker/s3-secret-access-key
ExecStartPre=/usr/bin/test -x /usr/bin/bwrap
ExecStartPre=/usr/bin/test -x /usr/bin/prlimit
ExecStartPre=/usr/bin/test -d /var/lib/kf-worker
ExecStartPre=/opt/kf/scripts/deploy/verify-liminal-runtime.sh /opt/kf
ExecStart=/usr/bin/env NODE_ENV=production DATABASE_URL_FILE=/etc/kf/worker/database-url /usr/bin/node /opt/kf/apps/worker/dist/main.js
Restart=on-failure
RestartSec=5s
TimeoutStopSec=2min
KillSignal=SIGTERM
# Ceilings for the whole cgroup. The Liminal child runs with RLIMIT_DATA 2 GiB and a 64 MiB
# tmpfs root (packages/documents/src/liminal-adapter/limits.ts); those bound one compile, this
# bounds the service. TasksMax is also the process-count limit for the sandbox: RLIMIT_NPROC
# counts every process of the uid, not the sandbox's tree, so the pids cgroup does that job.
MemoryHigh=3G
MemoryMax=4G
TasksMax=256
StateDirectory=kf-worker
StateDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# bubblewrap needs exactly these namespace classes to create the compiler child sandbox.
RestrictNamespaces=user mnt pid ipc net uts cgroup
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# The worker's syscall boundary, and — because seccomp filters are inherited across fork and
# exec and can only be added to — the floor under the Liminal sandbox too: bubblewrap and the
# compiler it starts run under every line here, and the compiler additionally under its own
# filter (packages/documents/src/liminal-adapter/seccomp.ts, `bwrap --seccomp`).
# @system-service is the node worker; @mount is bubblewrap building the sandbox. The second line
# takes back what neither needs; the third re-admits the two @privileged calls bubblewrap does
# need — measured with systemd-run on systemd 261: without capset it dies with SIGSYS, without
# pivot_root it cannot enter its root. tests/deployment/worker-syscall-filter.test.ts runs a
# real sandbox under exactly these lines.
SystemCallFilter=@system-service @mount
SystemCallFilter=~@privileged @debug @module @raw-io @reboot @swap @clock @cpu-emulation @obsolete @keyring userfaultfd kcmp process_vm_readv process_vm_writev
SystemCallFilter=capset pivot_root
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
