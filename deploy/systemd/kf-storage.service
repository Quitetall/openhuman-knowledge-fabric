[Unit]
Description=Replicate and re-verify artifact copies as the storage service actor
Documentation=file:///opt/kf/docs/decisions/0017-storage-locations.md
After=network-online.target
OnFailure=kf-alert@%n.service

[Service]
Type=oneshot
# Its own identity (ADR 0020). It holds the working store's credentials and the durable
# store's, and nothing else on this host needs both together.
User=kf-storage
Group=kf-storage
WorkingDirectory=/opt/kf
Environment=NODE_ENV=production
Environment=DATABASE_URL_FILE=/etc/kf/storage/database-url
Environment=S3_SECRET_ACCESS_KEY_FILE=/etc/kf/storage/s3-secret
Environment=S3_DURABLE_SECRET_ACCESS_KEY_FILE=/etc/kf/storage/s3-durable-secret
EnvironmentFile=/etc/kf/storage/storage.env
ExecStartPre=/usr/bin/test -s /etc/kf/storage/database-url
ExecStartPre=/usr/bin/test -s /etc/kf/storage/storage.env
ExecStartPre=/usr/bin/test -s /etc/kf/storage/s3-secret
ExecStartPre=/usr/bin/test -s /etc/kf/storage/s3-durable-secret
# Replicate first so a fresh copy is verified in the same run it was made. Orphan collection
# runs last and removes evidence bytes no record references once they are a week old: an
# ingest refused after its put leaves such bytes, and nothing else ever would remove them. It
# needs the working-store credential to hold s3:ListBucketVersions and
# s3:DeleteObjectVersion, and the actor's clearance to be the top classification; without
# either the run refuses, exits non-zero, and kf-alert@ fires.
ExecStart=/usr/bin/node /opt/kf/apps/kf-storage/dist/main.js --replicate --verify --older-than-days 30 --collect-orphans --grace-hours 168

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
SystemCallFilter=@system-service
SystemCallArchitectures=native
UMask=0077
