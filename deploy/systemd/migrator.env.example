# Install as /etc/kf/migrator.env, owned root:kf-migrator, mode 0640.
# Values are release-specific. Never reuse digest/receipt values for another release.
KF_DBMATE_BIN=/opt/kf/tools/dbmate
KF_EXPECTED_DBMATE_VERSION=2.35.0
KF_EXPECTED_RELEASE_MANIFEST_SHA256=replace-with-sha256-of-release-SHA256SUMS
KF_ROLLBACK_REHEARSAL_RECEIPT=/var/lib/kf-migrator/rollback-rehearsal-RELEASE_ID.receipt
KF_MIGRATION_APPLY_CONFIRMATION=apply-reviewed-release
