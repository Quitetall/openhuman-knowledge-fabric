# This host's PostgreSQL, as scripts/deploy/provision-host.sh provisions it. Non-secret.
# Install as /etc/kf/database.env, owned root:root, mode 0600; provision-host.sh does.
#
# local     a PostgreSQL 18 cluster on this host (Debian: postgresql-18 from PGDG, which creates
#           cluster 18/main). Provisioning makes the kf database and its extensions, the group roles
#           the migrations name, the migrator login and one login per service, each holding only
#           its group roles, with a generated password whose connection string goes into that
#           service's 0600 database-url file and nowhere else. It also installs the planner
#           settings (deploy/postgres/planner.conf) and creates the DISPOSABLE cluster the
#           migration rehearsal runs in (KF_REHEARSAL_CLUSTER; drop it after a rehearsal with
#           `pg_dropcluster --stop 18 rehearsal` and re-run provisioning for the next release).
# external  the database is somewhere else: every database-url file is a person's to supply.
KF_DATABASE=local
KF_DATABASE_CLUSTER=18/main
KF_DATABASE_NAME=kf
# Not "kf-rehearsal": postgresql@.service splits its instance name at the hyphen.
KF_REHEARSAL_CLUSTER=18/rehearsal
