# The host's own object store, kf-objects (SeaweedFS, ADR 0039). Non-secret. Install as
# /etc/kf/objects-init/objects.env, owned kf-objects-init, mode 0600; provision-host.sh does.
#
# kf-objects-init.service reads this to create the buckets and turn versioning on, as the store's
# administrator identity, whose secret is /etc/kf/objects-init/admin-secret (generated by
# provision-host.sh). The identities every service uses are rendered by provision-host.sh into
# /etc/kf/objects/identities.json from the services' own secret files.
KF_OBJECTS_ENDPOINT=http://127.0.0.1:8333
KF_OBJECTS_REGION=us-east-1
KF_OBJECTS_ACCESS_KEY_ID=kf-objects-admin
KF_OBJECTS_SECRET_ACCESS_KEY_FILE=/etc/kf/objects-init/admin-secret
# Every bucket KF writes to on a host. Versioning is enabled on each and read back.
KF_OBJECTS_BUCKETS=kf-artifacts
