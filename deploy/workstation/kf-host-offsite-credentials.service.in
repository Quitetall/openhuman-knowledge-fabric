[Unit]
Description=Supply only KF off-site ledger credentials from the workstation encrypted store
After=kf-host-1.service
Requires=kf-host-1.service
PartOf=kf-host-1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/node @SENDER@ offsite-sync @CONFIG@
TimeoutStartSec=55
NoNewPrivileges=true
MemorySwapMax=0
LimitCORE=0
UMask=0077
