[Unit]
Description=Supply only KF backup credentials from the workstation encrypted store
After=kf-host-1.service
Requires=kf-host-1.service
PartOf=kf-host-1.service

[Service]
Type=oneshot
ExecStart=/usr/bin/node @SENDER@ backup-sync @CONFIG@
TimeoutStartSec=55
NoNewPrivileges=true
LimitCORE=0
UMask=0077
